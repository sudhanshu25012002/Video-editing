// ---------- figma helpers ----------
const SS = {}; [1, 2, 3, 4, 5, 6, 7, 8].forEach(i => SS[i] = document.getElementById('s' + i));
function E(p, css, html, cls) { const e = document.createElement('div'); e.className = cls || 'a'; Object.assign(e.style, css || {}); if (html !== undefined) e.innerHTML = html; p.appendChild(e); return e; }
const AV = [['P', '#F24E1E'], ['A', '#0FA958'], ['H', '#5A17E6']];
function chrome(s, file) { E(s, {}, `<div class="ic on">▲</div><div class="ic">#</div><div class="ic">□</div><div class="ic">✎</div><div class="ic">T</div><div class="ic">💬</div><div class="file">Ruhaani Store / <b>${file}</b></div>${AV.map(([l, c]) => `<div class="av" style="background:${c}">${l}</div>`).join('')}<div class="share">Share</div><div style="color:#ccc;font-weight:700">▶</div>`, 'tb'); }
function frame(s, key, x, y, scale, label) { E(s, { left: x + 'px', top: y - 24 + 'px' }, label, 'flabel'); const f = E(s, { left: x + 'px', top: y + 'px', width: '360px', height: '780px', transform: `scale(${scale})` }, SCREENS[key](), 'frame'); return [x, y, 360 * scale, 780 * scale]; }
function sel(s, x, y, w, h, size) { E(s, { left: x + 'px', top: y + 'px', width: w + 'px', height: h + 'px' }, ['0,0', '50%,0', '100%,0', '0,50%', '100%,50%', '0,100%', '50%,100%', '100%,100%'].map(p => { const [a, b] = p.split(','); return `<i style="left:calc(${a.includes('%') ? a : a + 'px'} - 6px);top:calc(${b.includes('%') ? b : b + 'px'} - 6px)"></i>`; }).join('') + (size ? `<div class="sz">${size}</div>` : ''), 'sel'); }
function cursor(s, x, y, name, color) { E(s, { left: x + 'px', top: y + 'px' }, `<svg width="28" height="30" viewBox="0 0 28 30"><path d="M2 2 L24 13 L14 16 L9 27 Z" fill="${color}" stroke="#fff" stroke-width="2.5" stroke-linejoin="round"/></svg><span style="background:${color}">${name}</span>`, 'cur'); }
function comment(s, x, y, who, txt, color = '#5A17E6') { E(s, { left: x + 'px', top: y + 'px' }, `<div class="pin" style="background:${color}">${who[0]}</div><div class="bub"><b>${who}</b>${txt}</div>`, 'cmt'); }
function noodle(s, x1, y1, x2, y2) { const w = Math.abs(x2 - x1) + 80, mx = Math.min(x1, x2) - 40, my = Math.min(y1, y2) - 60, h = Math.abs(y2 - y1) + 120;
  E(s, { left: mx + 'px', top: my + 'px', width: w + 'px', height: h + 'px', zIndex: 24 }, `<svg width="${w}" height="${h}"><path d="M${x1 - mx} ${y1 - my} C ${(x1 + x2) / 2 - mx} ${y1 - my}, ${(x1 + x2) / 2 - mx} ${y2 - my}, ${x2 - mx - 10} ${y2 - my}" fill="none" stroke="#0D99FF" stroke-width="3.5"/><circle cx="${x1 - mx}" cy="${y1 - my}" r="8" fill="#fff" stroke="#0D99FF" stroke-width="3.5"/><path d="M${x2 - mx - 16} ${y2 - my - 9} L${x2 - mx} ${y2 - my} L${x2 - mx - 16} ${y2 - my + 9} Z" fill="#0D99FF"/></svg>`); }
function redH(s, x, y, w, label) { E(s, { left: x + 'px', top: y + 'px', width: w + 'px', height: '20px' }, `<div class="l" style="left:0;top:9px;width:${w}px;height:2px"></div><div class="l" style="left:0;top:3px;width:2px;height:14px"></div><div class="l" style="left:${w - 2}px;top:3px;width:2px;height:14px"></div><div class="t" style="left:${w / 2 - 14}px;top:-14px">${label}</div>`, 'red'); }
function head(s, kick, h, top = 110) { E(s, { top: top + 'px' }, `<div class="kick"><img src="data:image/png;base64,LOGO">${kick}</div><h1>${h}</h1>`, 'hb'); }
function foot(s, n, last) { E(s, {}, `<img src="data:image/png;base64,LOGO">HeliosLabs Storefront<span class="n">${n} / 08</span>${last ? '' : '<span class="sw">Swipe →</span>'}`, 'foot'); }
