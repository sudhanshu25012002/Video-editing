<style>
  :root { --bg: #F3ECDF; --pur: #5A17E6; --ink: #1C1726; --mut: #8A8172; --line: #E2D8C6; --card: #FFFDF8; --fig: #0D99FF; --rb: #7a1f35; --gold: #C9973F; }
  html, body { margin: 0; background: #ccc; }
  body { font-family: 'Inter', sans-serif; color: var(--ink); }
  .slide { position: relative; width: 1080px; height: 1350px; overflow: hidden; margin-bottom: 20px; background: var(--bg); background-image: radial-gradient(rgba(28,23,38,0.10) 1.6px, transparent 1.6px); background-size: 28px 28px; }
  .a { position: absolute; }
  /* figma chrome */
  .tb { position: absolute; left: 0; top: 0; width: 1080px; height: 64px; background: #1E1E1E; display: flex; align-items: center; padding: 0 22px; box-sizing: border-box; gap: 18px; color: #fff; font-size: 17px; font-weight: 600; }
  .tb .ic { width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #ddd; font-size: 18px; }
  .tb .ic.on { background: var(--fig); color: #fff; }
  .tb .file { margin: 0 auto; color: #eee; } .tb .file b { color: #fff; }
  .tb .av { width: 30px; height: 30px; border-radius: 15px; border: 2px solid #1E1E1E; margin-left: -10px; font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .tb .share { background: var(--fig); padding: 8px 16px; border-radius: 8px; font-weight: 700; }
  .flabel { position: absolute; font-size: 15px; font-weight: 600; color: #6b6470; white-space: nowrap; }
  .frame { position: absolute; background: #fff; overflow: hidden; box-shadow: 0 20px 50px rgba(28,23,38,0.14); transform-origin: 0 0; }
  .sel { position: absolute; border: 2px solid var(--fig); pointer-events: none; z-index: 20; }
  .sel i { position: absolute; width: 12px; height: 12px; background: #fff; border: 2px solid var(--fig); box-sizing: border-box; }
  .sel .sz { position: absolute; left: 50%; bottom: -36px; transform: translateX(-50%); background: var(--fig); color: #fff; font-size: 14px; font-weight: 700; padding: 4px 10px; border-radius: 5px; white-space: nowrap; }
  .cur { position: absolute; z-index: 30; }
  .cur span { position: absolute; left: 22px; top: 22px; padding: 6px 12px; border-radius: 4px 14px 14px 14px; color: #fff; font-size: 16px; font-weight: 700; white-space: nowrap; }
  .cmt { position: absolute; z-index: 25; display: flex; gap: 10px; align-items: flex-start; }
  .cmt .pin { width: 44px; height: 44px; border-radius: 22px 22px 22px 4px; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: 16px; box-shadow: 0 6px 16px rgba(0,0,0,0.2); }
  .cmt .bub { background: #fff; border-radius: 14px; padding: 12px 16px; font-size: 17px; font-weight: 600; box-shadow: 0 10px 26px rgba(28,23,38,0.15); max-width: 300px; line-height: 1.35; }
  .cmt .bub b { display: block; font-size: 14px; color: #8f8896; margin-bottom: 2px; }
  .red { position: absolute; z-index: 22; }
  .red .l { position: absolute; background: #F24822; }
  .red .t { position: absolute; background: #F24822; color: #fff; font-size: 13px; font-weight: 800; padding: 2px 7px; border-radius: 4px; }
  /* headline block */
  .hb { position: absolute; left: 60px; right: 60px; }
  .kick { display: inline-flex; align-items: center; gap: 12px; padding: 10px 18px; border-radius: 22px; background: var(--pur); color: #fff; font-weight: 800; font-size: 18px; letter-spacing: 0.1em; }
  .kick img { width: 26px; height: 26px; border-radius: 6px; }
  h1 { margin: 16px 0 0; font-size: 66px; font-weight: 800; letter-spacing: -0.045em; line-height: 1.03; }
  .p { color: var(--pur); }
  .foot { position: absolute; left: 60px; right: 60px; bottom: 40px; display: flex; align-items: center; gap: 14px; font-size: 21px; font-weight: 800; }
  .foot img { width: 46px; height: 46px; }
  .foot .n { margin-left: auto; color: var(--mut); letter-spacing: .08em; }
  .foot .sw { color: var(--pur); margin-left: 16px; }
  /* in-screen styles (360 wide design) */
  .scr { position: relative; width: 360px; font-family: 'Inter', sans-serif; color: #2a1a20; }
  .sb { height: 34px; display: flex; justify-content: space-between; align-items: center; padding: 0 20px; font-size: 12px; font-weight: 700; }
  .nav { height: 50px; display: flex; align-items: center; justify-content: space-between; padding: 0 18px; }
  .logo { font-family: 'DejaVu Serif', Georgia, serif; font-weight: 700; letter-spacing: 0.22em; font-size: 19px; color: var(--rb); }
  .btn { display: flex; align-items: center; justify-content: center; border-radius: 14px; font-weight: 800; font-size: 15px; }
  .chipx { padding: 7px 14px; border-radius: 18px; font-size: 12px; font-weight: 700; background: #F5EEE6; white-space: nowrap; }
</style></head><body>
