  gc(s, 60, 960, 960, `<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;text-align:center">${[['🔔', 'Occasion reminders'], ['🏢', 'Bulk & corporate'], ['💳', 'UPI · Card · COD'], ['📦', 'Pan-India delivery']].map(([e, n]) => `<div><div style="font-size:44px">${e}</div><div style="font-size:18px;font-weight:800;margin-top:6px">${n}</div></div>`).join('')}</div>`);
  cursor(s, 470, 820, 'Kavya · Designer', '#F24E1E');
