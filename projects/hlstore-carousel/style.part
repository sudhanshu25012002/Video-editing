<style>
  :root { --bg: #F3ECDF; --pur: #5A17E6; --ink: #1C1726; --mut: #8A8172; --line: #E2D8C6; --card: #FFFDF8; --sb: #8B2E3C; --sbp: #E07A7A; }
  html, body { margin: 0; background: #ccc; }
  body { font-family: 'Inter', sans-serif; color: var(--ink); }
  .slide { position: relative; width: 1080px; height: 1350px; overflow: hidden; margin-bottom: 20px; background: var(--bg); background-image: radial-gradient(rgba(90,23,230,0.07) 2.5px, transparent 2.5px); background-size: 44px 44px; }
  .a { position: absolute; }
  .top { position: absolute; left: 70px; right: 70px; top: 56px; height: 64px; display: flex; align-items: center; gap: 16px; }
  .top img { width: 60px; height: 60px; }
  .brand { font-weight: 800; font-size: 28px; letter-spacing: -0.02em; }
  .num { margin-left: auto; padding: 10px 22px; border-radius: 30px; background: var(--card); box-shadow: 0 0 0 2px var(--line); font-weight: 800; font-size: 22px; letter-spacing: 0.04em; }
  .kick { position: absolute; left: 70px; top: 168px; padding: 10px 20px; border-radius: 24px; background: var(--pur); color: #fff; font-weight: 800; font-size: 20px; letter-spacing: 0.1em; }
  h1 { position: absolute; left: 70px; right: 70px; top: 222px; margin: 0; font-size: 74px; font-weight: 800; letter-spacing: -0.045em; line-height: 1.02; }
  .p { color: var(--pur); } .sb { color: var(--sb); }
  .sub { position: absolute; left: 70px; right: 70px; font-size: 28px; font-weight: 500; color: #6a6270; line-height: 1.4; }
  .phone { position: absolute; border-radius: 54px; background: #16110f; padding: 13px; box-shadow: 0 34px 70px rgba(28,23,38,0.28), inset 0 0 0 2px #3a2f2a; }
  .phone .scr { border-radius: 42px; overflow: hidden; position: relative; }
  .phone .scr img { display: block; width: 100%; }
  .phone .isl { position: absolute; left: 50%; top: 10px; width: 90px; height: 26px; margin-left: -45px; border-radius: 13px; background: #000; z-index: 2; }
  .chip { position: absolute; display: flex; align-items: center; gap: 12px; padding: 14px 22px; border-radius: 20px; background: var(--card); box-shadow: 0 14px 34px rgba(28,23,38,0.14), 0 0 0 2px var(--line); font-weight: 800; font-size: 24px; white-space: nowrap; z-index: 5; }
  .dot { width: 34px; height: 34px; border-radius: 17px; background: var(--pur); color: #fff; font-size: 18px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; flex: none; }
  .foot { position: absolute; left: 70px; right: 70px; bottom: 44px; display: flex; align-items: center; justify-content: space-between; font-size: 22px; font-weight: 700; color: var(--mut); }
  .foot b { color: var(--ink); }
  .swipe { color: var(--pur); font-weight: 800; }
  .live { display: inline-flex; align-items: center; gap: 10px; padding: 10px 20px; border-radius: 24px; background: var(--card); box-shadow: 0 0 0 2px var(--line); color: var(--ink); font-weight: 800; }
  .live i { width: 12px; height: 12px; border-radius: 6px; background: #1f9d55; display: block; }
</style></head><body>
