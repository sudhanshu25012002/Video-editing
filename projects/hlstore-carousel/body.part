<style>
  .browser { position: absolute; border-radius: 20px; background: var(--card); box-shadow: 0 30px 70px rgba(28,23,38,0.16), 0 0 0 2px var(--line); overflow: hidden; }
  .browser .bar { height: 42px; background: #EDE5D7; display: flex; align-items: center; gap: 9px; padding-left: 18px; }
