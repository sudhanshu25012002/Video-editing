  .browser .url { margin-left: 14px; height: 26px; border-radius: 13px; background: var(--card); font-size: 15px; font-weight: 600; color: var(--mut); display: flex; align-items: center; padding: 0 14px; }
  .browser img { display: block; width: 100%; }
</style>
