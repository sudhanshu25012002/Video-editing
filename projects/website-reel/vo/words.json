[{"start": 0.0, "end": 2.28, "text": " अपका बिस्निस इंस्टर्ग्राम पर चल रहा है", "words": [[0.0, 0.36, " अपका"], [0.36, 0.82, " बिस्निस"], [0.82, 1.52, " इंस्टर्ग्राम"], [1.52, 1.7, " पर"], [1.7, 1.86, " चल"], [1.86, 2.14, " रहा"], [2.14, 2.28, " है"]]}, {"start": 2.28, "end": 3.5, "text": " लिकिन सोचिए", "words": [[2.28, 3.08, " लिकिन"], [3.08, 3.5, " सोचिए"]]}, {"start": 3.5, "end": 6.02, "text": " कल आपकी इंस्टर्ग्राम अईटी बन्द होगगे", "words": [[3.5, 4.2, " कल"], [4.2, 4.5, " आपकी"], [4.5, 5.04, " इंस्टर्ग्राम"], [5.04, 5.34, " अईटी"], [5.34, 5.76, " बन्द"], [5.76, 6.02, " होगगे"]]}, {"start": 6.02, "end": 7.12, "text": " तो क्या होगा", "words": [[6.02, 6.6, " तो"], [6.6, 6.82, " क्या"], [6.82, 7.12, " होगा"]]}, {"start": 7.68, "end": 9.94, "text": " आपके फोलोवर्स, आपके प्रोडट्ट्स", "words": [[7.679999999999999, 8.04, " आपके"], [8.04, 8.74, " फोलोवर्स,"], [9.02, 9.3, " आपके"], [9.3, 9.94, " प्रोडट्ट्स"]]}, {"start": 9.94, "end": 12.44, "text": " और कुस्टमर्स के अपसे कुन्टाक्त करने का", "words": [[9.94, 10.36, " और"], [10.36, 10.98, " कुस्टमर्स"], [10.98, 11.12, " के"], [11.12, 11.44, " अपसे"], [11.44, 11.94, " कुन्टाक्त"], [11.94, 12.22, " करने"], [12.22, 12.44, " का"]]}, {"start": 12.44, "end": 13.84, "text": " एक इंपोट्टन् रास्ता", "words": [[12.44, 12.7, " एक"], [12.7, 13.42, " इंपोट्टन्"], [13.42, 13.84, " रास्ता"]]}, {"start": 13.84, "end": 15.78, "text": " अपकोच अफैक्ट हो सकता है", "words": [[13.84, 14.68, " अपकोच"], [14.68, 15.2, " अफैक्ट"], [15.2, 15.34, " हो"], [15.34, 15.64, " सकता"], [15.64, 15.78, " है"]]}, {"start": 15.78, "end": 17.3, "text": " और सबसे बढ़ी बाट", "words": [[15.78, 16.4, " और"], [16.4, 16.82, " सबसे"], [16.82, 17.06, " बढ़ी"], [17.06, 17.3, " बाट"]]}, {"start": 17.3, "end": 20.24, "text": " इंस्टर्ग्राम पर अडियंस होने का मतलब ये नहीं", "words": [[17.3, 18.26, " इंस्टर्ग्राम"], [18.26, 18.44, " पर"], [18.44, 18.9, " अडियंस"], [18.9, 19.14, " होने"], [19.14, 19.26, " का"], [19.26, 19.62, " मतलब"], [19.62, 19.86, " ये"], [19.86, 20.24, " नहीं"]]}, {"start": 20.24, "end": 22.64, "text": " कि आपका पुरा बिस्निस आपके कंट्रोल में है", "words": [[20.24, 20.38, " कि"], [20.38, 20.68, " आपका"], [20.68, 21.16, " पुरा"], [21.16, 21.62, " बिस्निस"], [21.62, 21.94, " आपके"], [21.94, 22.34, " कंट्रोल"], [22.34, 22.64, " में"], [22.64, 22.64, " है"]]}, {"start": 22.64, "end": 26.04, "text": " इसी लिए अपनी खुद की वेप्साइट होना जरूरी है", "words": [[22.64, 23.42, " इसी"], [23.42, 23.72, " लिए"], [23.72, 24.12, " अपनी"], [24.12, 24.44, " खुद"], [24.44, 24.6, " की"], [24.6, 25.06, " वेप्साइट"], [25.06, 25.34, " होना"], [25.34, 25.86, " जरूरी"], [25.86, 26.04, " है"]]}, {"start": 36.76, "end": 42.04, "text": " अपने बिस्निस की पुरी अन्लाईं प्रेज़न् सिफ उसी पर देपन्ट्डन् मत रख है", "words": [[36.76, 37.66, " अपने"], [37.66, 38.46, " बिस्निस"], [38.46, 38.66, " की"], [38.66, 39.12, " पुरी"], [39.12, 39.56, " अन्लाईं"], [39.56, 40.08, " प्रेज़न्"], [40.08, 40.3, " सिफ"], [40.3, 40.68, " उसी"], [40.68, 40.86, " पर"], [40.86, 41.38, " देपन्ट्डन्"], [41.38, 41.62, " मत"], [41.62, 41.82, " रख"], [41.82, 42.04, " है"]]}, {"start": 42.04, "end": 45.12, "text": " इंस्टर्ग्राम आपकी दुकान का प्रमोशन है", "words": [[42.04, 43.22, " इंस्टर्ग्राम"], [43.22, 43.66, " आपकी"], [43.66, 44.12, " दुकान"], [44.12, 44.3, " का"], [44.3, 44.92, " प्रमोशन"], [44.92, 45.12, " है"]]}, {"start": 45.12, "end": 48.58, "text": " अपकी वेप्साइट आपकी अपनी दिजिटल प्रोप्टी है", "words": [[45.12, 45.88, " अपकी"], [45.88, 46.52, " वेप्साइट"], [46.52, 47.02, " आपकी"], [47.02, 47.52, " अपनी"], [47.52, 47.92, " दिजिटल"], [47.92, 48.38, " प्रोप्टी"], [48.38, 48.58, " है"]]}, {"start": 49.66, "end": 51.82, "text": " अपनी अन्लाईं दुकान बनाईए", "words": [[49.66, 50.54, " अपनी"], [50.54, 51.06, " अन्लाईं"], [51.06, 51.4, " दुकान"], [51.4, 51.82, " बनाईए"]]}, {"start": 51.82, "end": 55.22, "text": " प्लान स्टाड आप नोसो निन्यानवे रुपे पर मान्थ", "words": [[51.82, 52.52, " प्लान"], [52.52, 52.94, " स्टाड"], [52.94, 53.18, " आप"], [53.18, 53.6, " नोसो"], [53.6, 54.14